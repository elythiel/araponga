# Araponga — variables d'environnement
# Copier en `.env` pour le développement local : cp .env.example .env
#
# Toutes les variables lues par l'application sont listées ici.

# --- Application -------------------------------------------------------------

# URL publique de l'instance, sans barre oblique finale.
# Sert de base aux URL absolues (redirection OIDC, manifest PWA).
APP_URL=http://localhost:3000

# Niveau de journalisation : trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Données -----------------------------------------------------------------

# Répertoire unique contenant la base SQLite et les médias.
# En conteneur, c'est le point de montage du volume.
DATA_DIR=./data

# --- Authentification ---------------------------------------------------------
#
# Au démarrage, la configuration est validée : une variable manquante ou
# invalide empêche le serveur de démarrer, avec un message qui la nomme.

# Secret de scellement des cookies de session (32 caractères minimum).
# En changer invalide toutes les sessions en cours.
# La valeur ci-dessous ne sert qu'au développement local : en production,
# générer la sienne avec : openssl rand -base64 32
SESSION_PASSWORD=dev-uniquement-a-regenerer-en-production

# Ouvre une session administrateur factice via /api/auth/login, sans provider
# OIDC : les variables OIDC_* ci-dessous deviennent facultatives. Refusé si
# NODE_ENV=production, et signalé par un avertissement à chaque démarrage.
# Vider la valeur pour se connecter à un vrai provider.
AUTH_DEV_BYPASS=1

# --- Provider OIDC (obligatoire sans AUTH_DEV_BYPASS) --------------------------
#
# OIDC standard uniquement : n'importe quel provider conforme convient.

# Émetteur : l'URL racine, la découverte ajoute
# /.well-known/openid-configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=araponga
OIDC_CLIENT_SECRET=

# Portées demandées, séparées par des espaces. Doit contenir `openid`.
# Défaut : openid profile email
OIDC_SCOPES=openid profile email

# URI de retour, à déclarer à l'identique chez le provider.
# Défaut : APP_URL + /api/auth/callback
OIDC_REDIRECT_URI=
