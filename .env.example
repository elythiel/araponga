# Araponga — variables d'environnement
# Copier en `.env` pour le développement local : cp .env.example .env
#
# Toutes les variables lues par l'application sont listées ici.

# --- Application -------------------------------------------------------------

# URL publique de l'instance, sans barre oblique finale.
# Sert de base aux URL absolues (redirection OIDC, manifest PWA).
APP_URL=http://localhost:3000

# Niveau de journalisation : trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Données -----------------------------------------------------------------

# Répertoire unique contenant la base SQLite et les médias.
# En conteneur, c'est le point de montage du volume.
DATA_DIR=./data

# --- Authentification OIDC ---------------------------------------------------

# Émetteur OIDC : l'URL racine, la découverte ajoute
# /.well-known/openid-configuration. Une configuration incomplète empêche le
# démarrage avec un message nommant la variable manquante.
OIDC_ISSUER=
OIDC_CLIENT_ID=araponga
OIDC_CLIENT_SECRET=

# Doit être déclarée à l'identique chez le provider.
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Portées demandées, séparées par des espaces.
OIDC_SCOPES=openid profile email

# Secret de scellement du cookie de session (32 caractères minimum).
# En changer invalide toutes les sessions en cours.
# Générer avec : openssl rand -base64 32
SESSION_PASSWORD=

# Ouvre une session administrateur factice, sans provider OIDC.
# Refusé si NODE_ENV=production. Laisser vide hors dépannage local.
AUTH_DEV_BYPASS=
